{
  "name": "irrint",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/api.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts",
    "demo:start": "node scripts/demo.mjs",
    "demo:start:lan": "node scripts/demo.mjs --lan",
    "demo:start:reference": "node scripts/demo.mjs --reference-device",
    "demo:api": "tsx server/local.ts",
    "demo:device": "tsx simulator/run.ts",
    "client:device": "tsx clients/openapi-device.ts",
    "android:sync": "cap sync android",
    "android:debug:lan": "node scripts/android-debug.mjs",
    "demo:evidence": "tsx scripts/evidence.ts",
    "measure:latency": "tsx scripts/measure-latency.ts",
    "demo:new-session": "tsx scripts/new-session.ts",
    "start": "node scripts/hosted.mjs",
    "start:hosted": "node scripts/hosted.mjs",
    "contingency:start": "powershell -ExecutionPolicy Bypass -File contingency/Iniciar-Irrint.ps1",
    "contingency:build": "node scripts/contingency-build.mjs",
    "android:public": "node scripts/public-apk-build.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=.local/test-results.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@ionic/react": "9.0.3",
    "@ionic/react-router": "9.0.3",
    "ionicons": "8.1.0",
    "lucide-react": "0.487.0",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.2",
    "three": "0.185.0",
    "tsx": "^4.23.13",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
