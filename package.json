{
  "name": "irrint",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/api.test.ts",
    "demo:start": "node scripts/demo.mjs",
    "demo:api": "tsx server/local.ts",
    "demo:device": "tsx simulator/run.ts",
    "android:sync": "cap sync android",
    "demo:evidence": "tsx scripts/evidence.ts",
    "demo:new-session": "tsx scripts/new-session.ts",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=.local/test-results.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@ionic/react": "9.0.3",
    "@ionic/react-router": "9.0.3",
    "ionicons": "8.1.0",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.2",
    "three": "0.185.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
